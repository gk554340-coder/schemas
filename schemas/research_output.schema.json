{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomous-cinema-studio.local/schemas/research_output.schema.json",
  "title": "Autonomous AI Cinema Studio Research Output",
  "description": "Immutable contract for verified research evidence, source provenance, historical timelines, locations, and factual context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "topic",
    "language",
    "retrieved_at",
    "sources",
    "facts",
    "timeline",
    "locations",
    "historical_context",
    "unresolved_questions",
    "research_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchSource"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchFact"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locationRecord"
      }
    },
    "historical_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historicalContext"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      }
    },
    "research_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "insufficient_evidence",
        "failed"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "title",
        "publisher",
        "published_at",
        "retrieved_at",
        "source_type",
        "retrieval_status",
        "content_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC_[A-Za-z0-9_-]{1,120}$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 4096
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "web",
            "news_rss",
            "scripture_api",
            "official_document",
            "book",
            "archive",
            "other"
          ]
        },
        "retrieval_status": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failed"
          ]
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "researchFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "claim",
        "verification_status",
        "source_ids",
        "confidence",
        "limitations"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^FACT_[A-Za-z0-9_-]{1,120}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "partially_verified",
            "unverified",
            "disputed"
          ]
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC_[A-Za-z0-9_-]{1,120}$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              },
              "confidence": {
                "minimum": 0.5
              }
            }
          }
        }
      ]
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "date_text",
        "timestamp",
        "description",
        "fact_ids",
        "source_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVENT_[A-Za-z0-9_-]{1,120}$"
        },
        "date_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT_[A-Za-z0-9_-]{1,120}$"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC_[A-Za-z0-9_-]{1,120}$"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "fact_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "source_ids": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "locationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "name",
        "description",
        "latitude",
        "longitude",
        "fact_ids",
        "source_ids"
      ],
      "properties": {
        "location_id": {
          "type": "string",
          "pattern": "^LOC_[A-Za-z0-9_-]{1,120}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "\\S"
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT_[A-Za-z0-9_-]{1,120}$"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC_[A-Za-z0-9_-]{1,120}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latitude": {
                "type": "number"
              }
            },
            "required": [
              "latitude"
            ]
          },
          "then": {
            "properties": {
              "longitude": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "longitude": {
                "type": "number"
              }
            },
            "required": [
              "longitude"
            ]
          },
          "then": {
            "properties": {
              "latitude": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "historicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "description",
        "fact_ids",
        "source_ids"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^CTX_[A-Za-z0-9_-]{1,120}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FACT_[A-Za-z0-9_-]{1,120}$"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC_[A-Za-z0-9_-]{1,120}$"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "fact_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "source_ids": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
